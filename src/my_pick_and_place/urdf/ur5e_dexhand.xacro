<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_ur">

  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="generate_ros2_control_tag" default="true"/>
  <xacro:arg name="sim_ignition" default="true"/>

  <!-- Fingertip force sensing, OFF by default so every existing launch produces exactly
       the robot that picked all ten apples. With tactile:=true, each fingertip joint gets
       a force_torque sensor: a load cell in the tip, reading contact force in newtons.
       Needed because joint effort (what the grasp reads today) is a torque that saturates
       at 1.5Nm, so a firm grip and a crushing grip read the same. -->
  <xacro:arg name="tactile" default="false"/>
  <!-- 50Hz, not 100: at 100 the simulation dropped from about 0.11x to 0.070x real
       time, and this project has already been bitten twice by timing changing the
       grasp. 50Hz is still 20 samples per closing step. -->
  <xacro:property name="tactile_rate" value="50"/>
  <xacro:if value="$(arg tactile)">
    <xacro:macro name="fingertip_ft" params="joint sensor">
      <gazebo reference="${joint}">
        <sensor name="${sensor}" type="force_torque">
          <always_on>1</always_on>
          <update_rate>${tactile_rate}</update_rate>
          <visualize>false</visualize>
          <force_torque>
            <!-- Report in the child (fingertip) frame: that is where contact happens. -->
            <frame>child</frame>
            <measure_direction>parent_to_child</measure_direction>
          </force_torque>
        </sensor>
      </gazebo>
    </xacro:macro>
    <xacro:fingertip_ft joint="R_Index_DIP"  sensor="index_tip_ft"/>
    <xacro:fingertip_ft joint="R_Middle_DIP" sensor="middle_tip_ft"/>
    <xacro:fingertip_ft joint="R_Ring_DIP"   sensor="ring_tip_ft"/>
    <xacro:fingertip_ft joint="R_Pinky_DIP"  sensor="pinky_tip_ft"/>
    <xacro:fingertip_ft joint="R_Thumb_DIP"  sensor="thumb_tip_ft"/>

    <!-- Contact sensors on EVERY finger segment, not just the tips. The force_torque
         sensors above report the joint's reaction force (about 100N on the thumb while
         holding a 4N apple) and only see the tip link, so the 12cm apple, held on the
         inner segments, read 0N while it was held. A contact sensor reports which segment
         touches what, where, and how deep. Collision names are what the URDF->SDF
         conversion produces for these links (checked with ign sdf -p). -->
    <xacro:macro name="segment_contact" params="link topic">
      <gazebo reference="${link}">
        <sensor name="${topic}_contact" type="contact">
          <always_on>1</always_on>
          <update_rate>${tactile_rate}</update_rate>
          <topic>/tactile/${topic}</topic>
          <contact>
            <collision>${link}_collision</collision>
          </contact>
        </sensor>
      </gazebo>
    </xacro:macro>
    <xacro:segment_contact link="Index_Knuckle_1"  topic="index_proximal"/>
    <xacro:segment_contact link="Index_Middle_1"   topic="index_middle"/>
    <xacro:segment_contact link="Index_Tip_1"      topic="index_tip"/>
    <xacro:segment_contact link="Middle_Knuckle_1" topic="middle_proximal"/>
    <xacro:segment_contact link="Middle_Middle_1"  topic="middle_middle"/>
    <xacro:segment_contact link="Midle_Tip_1"      topic="middle_tip"/>
    <xacro:segment_contact link="Ring_Knuckle_1"   topic="ring_proximal"/>
    <xacro:segment_contact link="Ring_Middle_1"    topic="ring_middle"/>
    <xacro:segment_contact link="Ring_Tip_1"       topic="ring_tip"/>
    <xacro:segment_contact link="Pinky_Knuckle_1"  topic="pinky_proximal"/>
    <xacro:segment_contact link="Pinky_Middle_1"   topic="pinky_middle"/>
    <xacro:segment_contact link="Pinky_Tip_1"      topic="pinky_tip"/>
    <xacro:segment_contact link="Thumb_Knuckle_1"  topic="thumb_proximal"/>
    <xacro:segment_contact link="Thumb_Middle_1"   topic="thumb_middle"/>
    <xacro:segment_contact link="Thumb_Tip_1"      topic="thumb_tip"/>
  </xacro:if>

  <link name="base_footprint"/>

  <!-- Mobile Base -->
  <link name="mobile_base_link">
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry><box size="0.8 0.6 0.25"/></geometry>
      <material name="chassis_dark"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry><box size="0.8 0.6 0.25"/></geometry>
    </collision>
    <inertial>
      <mass value="100.0"/>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <inertia ixx="4.0" ixy="0" ixz="0" iyy="6.0" iyz="0" izz="7.0"/>
    </inertial>
  </link>

  <!-- Positioning is done dynamically at runtime by teleporting base_footprint (see
       teleport() / DELIVERY_ROBOT_X/Y/YAW in full_layer_grasp.py). This joint must
       stay at zero offset, or the real arm mount silently drifts away from wherever
       the Python math thinks the robot is. It used to carry a hardcoded (1.375, -0.55,
       +90deg) offset from before teleport-based positioning existed; that stale offset
       was never accounted for anywhere in world_to_local()/solve_ik(), which is why
       the arm kept reaching from the "wrong side" no matter what station or IK
       heuristic was tried: the self-checks were all internally consistent with the
       wrong physical frame.-->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="mobile_base_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Drive Wheels -->
  <link name="left_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.12" length="0.05"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.12" length="0.05"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="mobile_base_link"/><child link="left_wheel"/><origin xyz="0 0.33 0.12" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.12" length="0.05"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.12" length="0.05"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="mobile_base_link"/><child link="right_wheel"/><origin xyz="0 -0.33 0.12" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="caster_front">
    <visual><geometry><sphere radius="0.06"/></geometry></visual>
    <collision><geometry><sphere radius="0.06"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="caster_front_joint" type="fixed">
    <parent link="mobile_base_link"/><child link="caster_front"/><origin xyz="0.3 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="caster_back">
    <visual><geometry><sphere radius="0.06"/></geometry></visual>
    <collision><geometry><sphere radius="0.06"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="caster_back_joint" type="fixed">
    <parent link="mobile_base_link"/><child link="caster_back"/><origin xyz="-0.3 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Include UR Robot with Horizontal Arm Pose -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="mobile_base_link"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    generate_ros2_control_tag="$(arg generate_ros2_control_tag)"
    sim_ignition="$(arg sim_ignition)"
    initial_positions="${dict(shoulder_pan_joint=0.0, shoulder_lift_joint=-1.5708, elbow_joint=1.5708, wrist_1_joint=-1.5708, wrist_2_joint=-1.5708, wrist_3_joint=0.0)}"
  >
    <origin xyz="0 0 0.285" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- shoulder_lift_joint was hitting its 150Nm effort limit and getting physically
       stuck near 0deg no matter what angle it was commanded to (it could reach its
       -68.75deg rest pose fine, but nothing positive/forward); confirmed NOT the
       overhead camera pole (moved well clear of the robot, problem persisted
       identically). The most likely remaining cause is the arm's own upper_arm_link
       swinging down into mobile_base_link's box, which sits directly beneath the
       shoulder mount. selfCollide was already found and disabled on all DexHand
       finger links earlier for the same symptom (a finger spiking to 33Nm against
       itself); this applies the identical fix to the arm's own links against the
       mobile base they're mounted on. -->
  <gazebo reference="mobile_base_link"><selfCollide>false</selfCollide></gazebo>
  <gazebo reference="base_link"><selfCollide>false</selfCollide></gazebo>
  <gazebo reference="base_link_inertia"><selfCollide>false</selfCollide></gazebo>
  <gazebo reference="shoulder_link"><selfCollide>false</selfCollide></gazebo>
  <gazebo reference="upper_arm_link"><selfCollide>false</selfCollide></gazebo>
  <gazebo reference="forearm_link"><selfCollide>false</selfCollide></gazebo>
  <gazebo reference="wrist_1_link"><selfCollide>false</selfCollide></gazebo>
  <gazebo reference="wrist_2_link"><selfCollide>false</selfCollide></gazebo>
  <gazebo reference="wrist_3_link"><selfCollide>false</selfCollide></gazebo>

  <!-- Attach DexHand Flush -->
  <xacro:include filename="$(find dexhandv2_description)/urdf/dexhandv2_right.urdf"/>
  <joint name="tool0_to_dexhand" type="fixed">
    <parent link="tool0"/>
    <child link="dexhand_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <!-- Gripper Camera -->
<link name="gripper_camera_link">
  <visual>
    <geometry>
      <box size="0.04 0.04 0.02"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="0.04 0.04 0.02"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.05"/>
    <inertia
      ixx="0.00001"
      ixy="0.0"
      ixz="0.0"
      iyy="0.00001"
      iyz="0.0"
      izz="0.00001"/>
  </inertial>
</link>

<joint name="dexhand_to_camera" type="fixed">
  <parent link="dexhand_base_link"/>
  <child link="gripper_camera_link"/>
  <origin xyz="0.0 -0.06 0.08" rpy="0 0 0"/>
</joint>
<gazebo reference="gripper_camera_link">
  <sensor name="gripper_camera_sensor" type="camera">
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>30</update_rate>

    <camera>
      <horizontal_fov>1.047</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.05</near>
        <far>5.0</far>
      </clip>
    </camera>

    <topic>/gripper_camera</topic>
  </sensor>
</gazebo>
  

  <!-- Gazebo Control Plugins -->
  <gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
    </plugin>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.66</wheel_separation>
      <wheel_radius>0.12</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <ros2_control name="DexHandSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="R_Index_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Middle_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Ring_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Pinky_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Index_Flexor">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Middle_Flexor">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Ring_Flexor">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Pinky_Flexor">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Index_DIP">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Middle_DIP">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Ring_DIP">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Pinky_DIP">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Thumb_Yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Thumb_Roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Thumb_Flexor">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Thumb_DIP">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Index_Yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Middle_Yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Ring_Yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Pinky_Yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="R_Thumb_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>
