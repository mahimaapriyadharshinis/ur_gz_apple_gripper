<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="apple_08">
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.65178</mass>
        <inertia>
          <ixx>0.00086799</ixx>
          <iyy>0.00086799</iyy>
          <izz>0.00086799</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.05770</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.78</mu>
              <mu2>0.78</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>180000.0</kp>
              <kd>1.1</kd>
              <min_depth>0.002</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Flat base. A perfect sphere on a flat table has a single point of contact and
           nothing resisting a roll, so the smallest nudge, a teleport, a respawn, a
           finger passing close, sets it rolling at constant speed. Logged directly: an
           apple moving 0.028m, 0.028m, 0.028m, 0.028m across four consecutive arm moves,
           and attempts abandoned because the apple had rolled 11-18mm while the hand was
           still centimetres away. A real apple rests on a flattened base and does not do
           this. The bottom face is flush with the sphere's lowest point, so the resting
           height and every grasp contact (all well above -48mm from
           the centre) are unchanged. -->
      <collision name="flat_base">
        <pose>0 0 -0.05270 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0250</radius>
            <length>0.0100</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.78</mu>
              <mu2>0.78</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>180000.0</kp>
              <kd>1.1</kd>
              <min_depth>0.002</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>


      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://apple_08/meshes/apple_08_v4.obj</uri>
            <scale>0.05770 0.05770 0.05770</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.431 0.137 0.098 1</ambient>
          <diffuse>0.431 0.137 0.098 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
    </link>
      <plugin
      filename="libignition-gazebo-pose-publisher-system.so"
      name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
    </plugin>
</model>
</sdf>
