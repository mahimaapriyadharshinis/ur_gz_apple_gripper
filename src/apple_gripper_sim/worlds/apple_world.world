<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="apple_world">
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <!-- ogre2/GL3Plus crashes on this VM's driver during its own internal scene
           bootstrap (Ogre::UnimplementedException in GL3PlusTextureGpu::copyTo,
           inside CreateMaterials(); happens before any world content loads, so
           it's not specific to the apple/crate models). Legacy ogre1 uses a
           different codepath and doesn't hit this. -->
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <include>
	<uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sun</uri>
    </include>
    <include>
  	<uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Ground Plane</uri>
    </include>
    
    <!-- Table the apple row sits on. Raises apples from ground level (which required
         an extreme, always-twisted arm reach; confirmed via a 70-position sweep, not
         fixable by repositioning) to a more natural working height. Top surface at
         z=0.40; apples spawn 0.01m above it, matching how they sat 0.01m above the
         ground before. Length covers the full 0..2.25 row with margin. -->
    <model name="apple_table">
      <static>true</static>
      <pose>1.125 0.0 0.0 0 0 0</pose>
      <link name="top">
        <collision name="top_collision">
          <pose>0 0 0.20 0 0 0</pose>
          <geometry><box><size>2.60 0.50 0.40</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.20 0 0 0</pose>
          <geometry><box><size>2.60 0.50 0.40</size></box></geometry>
          <material>
            <ambient>0.55 0.42 0.30 1</ambient>
            <diffuse>0.55 0.42 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://apple_01</uri>
      <name>apple_01</name>
      <pose>0.00 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_02</uri>
      <name>apple_02</name>
      <pose>0.25 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_03</uri>
      <name>apple_03</name>
      <pose>0.50 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_04</uri>
      <name>apple_04</name>
      <pose>0.75 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_05</uri>
      <name>apple_05</name>
      <pose>1.00 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_06</uri>
      <name>apple_06</name>
      <pose>1.25 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_07</uri>
      <name>apple_07</name>
      <pose>1.50 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_08</uri>
      <name>apple_08</name>
      <pose>1.75 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_09</uri>
      <name>apple_09</name>
      <pose>2.00 0.00 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_10</uri>
      <name>apple_10</name>
      <pose>2.25 0.00 0.45 0 0 0</pose>
    </include>

    <!-- Collection crate at the delivery station's place target. Position must stay in
         sync with CRATE_WORLD_XY in full_layer_grasp.py (derived from DELIVERY_ROBOT_X/Y
         and CRATE_LOCAL_XY); if you change either constant, update this pose too. -->
    <include>
      <uri>model://crate</uri>
      <name>crate</name>
      <pose>1.25 -1.50 0.0 0 0 0</pose>
    </include>

    <!-- Fixed overhead camera on its own stand, NOT attached to the robot.
         Y moved to 1.0 (the far side of the apple row from the robot, which operates
         between Y=-0.7 and Y=0.0), since the pole's collision cylinder spans the full
         height (z=0 to 2.5) and used to sit at Y=0.0, only ~9.5cm from apple_06 in X,
         squarely inside the arm's sweep while lowering/bending. Confirmed as a real
         physical collision, not a control issue: shoulder_lift_joint was hitting its
         150Nm effort limit and still couldn't reach its commanded angle. The camera's
         downward view will need re-aiming/re-calibrating for this new position before
         its detection pipeline is actually wired into the pick decision (a separate,
         not-yet-implemented task); CAMERA_WORLD_XYZ in detect_apples.py must be
         updated to match whenever that happens. -->
    <model name="overhead_camera_rig">
      <static>true</static>
      <pose>1.125 1.0 0.0 0 0 0</pose>
      <link name="stand">
        <visual name="pole_visual">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2.5</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>2.5</length></cylinder></geometry>
        </collision>
        <visual name="camera_box_visual">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.06</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <sensor name="overhead_camera_sensor" type="camera">
          <pose>0 0 2.5 0 1.5708 0</pose>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <topic>/overhead_camera</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
